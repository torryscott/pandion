<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Hardened-runtime entitlements for the notarized build. Electron's V8
     needs JIT; the second key covers older Electron memory behavior and is
     harmless where unneeded. Nothing else: the app reads and writes files
     only through user-driven dialogs, which need no entitlement outside
     the Mac App Store sandbox. -->
<plist version="1.0">
<dict>
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
</dict>
</plist>
