{
	"name": "pandion",
	"compatibility_date": "2026-07-25",
	// The usage counters (worker/README.md). Static files are still served
	// first, exactly as before; the Worker answers only the paths that are
	// not files: POST /api/hit/<kind>, GET /api/counts and GET /api/daily.
	"main": "worker/index.js",
	"assets": {
		"directory": "./website",
		"not_found_handling": "404-page",
		"binding": "ASSETS"
	},
	// The counter database (worker/README.md): created once with
	// npx wrangler d1 create pandion-counts; the Worker reads it under
	// this binding name.
	// The hourly GitHub download check (snapshotDownloads in worker/index.js):
	// GitHub keeps only a running total per file, so the Worker notes the
	// totals each hour and records how much they grew. Minute 59, so each
	// day's last check lands just before midnight UTC.
	"triggers": {
		"crons": ["59 * * * *"]
	},
	"d1_databases": [
		{
			"binding": "pandion_counts",
			"database_name": "pandion-counts",
			"database_id": "59b66b38-a062-494d-a5a1-d5ad1623b838"
		}
	]
}