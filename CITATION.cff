    given-names: "Torry Scott"
    name-suffix: "PhD"
version: "3.1.1"
license: GPL-3.0
repository-code: "https://github.com/torryscott/pandion"
url: "https://pandionplots.com"
keywords:
  - data visualization
  - statistics
  - jamovi
  - teaching
  - research software
