# Baseline protection for every static response.
/*
  Content-Security-Policy: frame-ancestors 'none'
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), geolocation=(), microphone=()

# The web app's scripts carry a content hash in the filename (see
# build.sh), so a given URL's bytes can never change, and a repeat visitor
# re-downloads nothing of the 2.1 MB chart engine.
#
# A day rather than a year, and deliberately NOT immutable. These headers
# apply to whatever the edge returns, including a 404, and during a deploy
# an edge can briefly hold the new shell HTML while the hashed script it
# asks for has not landed yet. That 404 was observed being cached with
# `cf-cache-status: HIT` and a one-year immutable TTL (Aug 2026), which
# means some visitors get a broken app and it cannot heal on its own.
# One day bounds that to a day, and dropping `immutable` lets a reload
# revalidate, so an affected visitor can recover by refreshing. The cost
# is one conditional request per file per day, which is nothing next to
# shipping a dead app to a share of users for a year.
/app/lib/*
  Cache-Control: public, max-age=86400

# The update manifest is fetched cross-origin by saved portable copies
# (file:// origins) and the desktop apps (Help > Check for updates), so
# it must answer with open CORS or the check silently does nothing.
# Short cache: a stale version number defeats the file's whole purpose.
/app/version.json
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=300

# The shell must never be cached hard, or a visitor keeps an old page
# pointing at script names that a later deploy has already pruned.
/app/
  Cache-Control: public, max-age=0, must-revalidate
/app/index.html
  Cache-Control: public, max-age=0, must-revalidate

# Cloudflare Pages: keep review-only artifacts out of search results.
# They are still reachable by URL; they simply should not be indexed.
/v2.html
  X-Robots-Tag: noindex
/v3.html
  X-Robots-Tag: noindex
